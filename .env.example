# Copy to .env for local development
NODE_ENV=development
PORT=3001
# Login role used by the app; it switches to a per-module role inside each transaction
DATABASE_URL=postgres://atp_app:atp_app@localhost:5432/atp
# Superuser connection used only by the migration runner
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/atp
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
WORKER_CONCURRENCY_CRITICAL=10
WORKER_CONCURRENCY_DEFAULT=5
WORKER_CONCURRENCY_BULK=2
OTEL_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:3000
