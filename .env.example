# Copy to .env for local development
NODE_ENV=development
PORT=3001
# Login role used by the app; it switches to a per-module role inside each transaction
DATABASE_URL=postgres://atp_app:atp_app@localhost:5432/atp
# Superuser connection used only by the migration runner
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/atp
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
WORKER_CONCURRENCY_CRITICAL=10
WORKER_CONCURRENCY_DEFAULT=5
WORKER_CONCURRENCY_BULK=2
OTEL_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
# 32 random bytes, base64 (openssl rand -base64 32). Unset in dev uses a built-in dev key; required in production.
# FIELD_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# fake: in-process KYC, e-signature and billing stand-ins (not allowed in production)
PROVIDERS_MODE=fake
# smtp (Mailpit locally), log (print emails to the worker output) or memory (tests)
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Advisor Travel Platform <no-reply@atp.local>
